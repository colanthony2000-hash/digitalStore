# Cloud Run URL or the custom domain configured for this service.
APP_URL="https://digital.jeneconk.com"

# Preferred production database configuration: Neon PostgreSQL.
# Use a Neon connection string with sslmode=verify-full, supplied through Secret Manager.
# Never put a real credential in this file.
DATABASE_URL=""
SQL_POOL_MAX="2"
ENABLE_DEMO_SEED="false"

# Optional legacy/local Cloud SQL connection settings. Leave blank unless deliberately
# using a separate development database. DATABASE_URL takes precedence when present.
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Neon Object Storage. These values should be injected from Secret Manager at runtime.
OBJECT_STORAGE_BACKEND="local"
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_MAX_BYTES="4000000000"
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Security: Secret key used to sign time-limited digital download tokens.
# Use a cryptographically random value of at least 32 bytes in production.
DOWNLOAD_SIGNING_SECRET="replace-with-strong-random-32-byte-secret"

# Comma-separated list of administrator email addresses (Firebase Auth verified emails).
ADMIN_EMAILS="jeneconklms@gmail.com"

# Optional transactional email. Resend is preferred when configured.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
RESEND_API_KEY=""

# Optional native checkout (Paystack). Native checkout remains off until the admin setting is enabled.
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
# Current Paystack webhook signing secret (whsec_...). Legacy x-paystack-signature
# events are also verified with PAYSTACK_SECRET_KEY while Paystack still sends them.
PAYSTACK_WEBHOOK_SECRET=""
# Keep test keys from activating checkout on production Cloud Run revisions.
# Set true only on an isolated staging service while running Paystack test transactions.
PAYSTACK_ALLOW_TEST_MODE="false"

# Optional Marketing & Analytics IDs - Disabled when unset or set to development placeholders.
# Pinterest Tag ID must be a genuine numeric Pinterest Tag ID (e.g. 2612345678901).
PINTEREST_TAG_ID=""
GA_MEASUREMENT_ID=""
