# Cloud Run URL or the custom domain configured for this service.
APP_URL="https://digital.jeneconk.com"

# Cloud SQL PostgreSQL via the Cloud Run Cloud SQL connection.
# Set SQL_HOST to /cloudsql/PROJECT_ID:REGION:INSTANCE_ID after attaching the instance.
SQL_HOST="/cloudsql/gen-lang-client-0441456997:europe-west2:ai-studio-30836c46"
SQL_USER="digitalstore_app"
SQL_PASSWORD=""
SQL_DB_NAME="digitalstore"
SQL_POOL_MAX="3"

# GEMINI_API_KEY: Optional server-side Gemini API key if AI features are enabled later.
GEMINI_API_KEY=""

# Security: Secret key used to sign time-limited digital download tokens.
DOWNLOAD_SIGNING_SECRET="replace-with-strong-random-32-byte-secret"

# Comma-separated list of administrator email addresses (Firebase Auth verified emails).
ADMIN_EMAILS="jeneconklms@gmail.com"

# Stage 2 Native Checkout (Paystack) - Optional and disabled when unset or placeholder.
# Replace with genuine keys (sk_test_... / sk_live_...) and enable in Admin Settings when ready.
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Optional Marketing & Analytics IDs - Disabled when unset or set to development placeholders.
# Pinterest Tag ID must be a genuine numeric Pinterest Tag ID (e.g. 2612345678901).
PINTEREST_TAG_ID=""
GA_MEASUREMENT_ID=""
