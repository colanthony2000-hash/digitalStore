{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npx vite build",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://digitalstore-899601549691.europe-west3.run.app/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://digitalstore-899601549691.europe-west3.run.app/uploads/$1"
    },
    {
      "source": "/robots.txt",
      "destination": "https://digitalstore-899601549691.europe-west3.run.app/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://digitalstore-899601549691.europe-west3.run.app/sitemap.xml"
    },
    {
      "source": "/health",
      "destination": "https://digitalstore-899601549691.europe-west3.run.app/health"
    },
    {
      "source": "/readyz",
      "destination": "https://digitalstore-899601549691.europe-west3.run.app/readyz"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
